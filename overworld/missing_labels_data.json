tflag","flag":"FLAG_TUTOR_MIMIC"},{"op":"goto","label":"EventScript_MimicTaught"},{"op":"end"}],"EventScript_MimicTaught":[{"op":"setvar","var":"VAR_RESULT","value":0},{"op":"branch","kind":"call","cond":{"var":"VAR_RESULT","cmp":"eq","value":"MALE"},"label":"EventScript_MimicTaughtMale"},{"op":"branch","kind":"call","cond":{"var":"VAR_RESULT","cmp":"eq","value":"FEMALE"},"label":"EventScript_MimicTaughtFemale"},{"op":"release"},{"op":"end"}],"EventScript_MimicTaughtMale":[{"op":"msg","text":"Text_MimicTaughtMale"},{"op":"return"}],"EventScript_MimicTaughtFemale":[{"op":"msg","text":"Text_MimicTaughtFemale"},{"op":"return"}],"EventScript_MimicDeclined":[{"op":"msg","text":"Text_MimicDeclined"},{"op":"release"},{"op":"end"}],"EventScript_ThunderWaveTutor":[{"op":"lock"},{"op":"faceplayer"},{"op":"branch","kind":"goto","cond":{"flag":"FLAG_TUTOR_THUNDER_WAVE","state":true},"label":"EventScript_ThunderWaveTaught"},{"op":"msg","text":"Text_ThunderWaveTeach"},{"op":"prompt"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"NO"},"label":"EventScript_ThunderWaveDeclined"},{"op":"call","label":"EventScript_CanOnlyBeLearnedOnce"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"NO"},"label":"EventScript_ThunderWaveDeclined"},{"op":"msg","text":"Text_ThunderWaveWhichMon"},{"op":"setvar","var":"VAR_0x8005","value":"MOVETUTOR_THUNDER_WAVE"},{"op":"call","label":"EventScript_ChooseMoveTutorMon"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"FALSE"},"label":"EventScript_ThunderWaveDeclined"},{"op":"setflag","flag":"FLAG_TUTOR_THUNDER_WAVE"},{"op":"goto","label":"EventScript_ThunderWaveTaught"},{"op":"end"}],"EventScript_ThunderWaveTaught":[{"op":"msg","text":"Text_ThunderWaveTaught"},{"op":"release"},{"op":"end"}],"EventScript_ThunderWaveDeclined":[{"op":"msg","text":"Text_ThunderWaveDeclined"},{"op":"release"},{"op":"end"}],"EventScript_DreamEaterTutor":[{"op":"lock"},{"op":"faceplayer"},{"op":"branch","kind":"goto","cond":{"flag":"FLAG_TUTOR_DREAM_EATER","state":true},"label":"EventScript_DreamEaterTaught"},{"op":"msg","text":"Text_DreamEaterTeach"},{"op":"prompt"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"NO"},"label":"EventScript_DreamEaterDeclined"},{"op":"call","label":"EventScript_CanOnlyBeLearnedOnce"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"NO"},"label":"EventScript_DreamEaterDeclined"},{"op":"msg","text":"Text_DreamEaterWhichMon"},{"op":"setvar","var":"VAR_0x8005","value":"MOVETUTOR_DREAM_EATER"},{"op":"call","label":"EventScript_ChooseMoveTutorMon"},{"op":"branch","kind":"goto","cond":{"var":"VAR_RESULT","cmp":"eq","value":"FALSE"},"label":"EventScript_DreamEaterDeclined"},{"op":"setflag","flag":"FLAG_TUTOR_DREAM_EATER"},{"op":"goto","label":"EventScript_DreamEaterTaught"},{"op":"end"}],"EventScript_DreamEaterTaught":[{"op":"msg","text":"Text_DreamEaterTaught"},{"op":"release"},{"op":"end"}],"EventScript_DreamEaterDeclined":[{"op":"msg","text":"Text_DreamEaterDeclined"},{"op":"release"},{"op":"end"}]},"strings":{"Text_SoftboiledTeach":"Hello, there!\nI've seen you about, but I never had a chance to chat.\nIt must be good luck that brought us together finally.\nI'd like to celebrate by teaching you the move SOFTBOILED.","Text_SoftboiledWhichMon":"So, who's the POKéMON that gets the chance to learn SOFTBOILED?","Text_SoftboiledTaught":"I wish you the best of luck!","Text_SoftboiledDeclined":"I'll always be keeping an eye out for you.\nI hope we can chat again.","Text_CounterTeach":"Oh, hi! I finally finished POKéMON.\nNot done yet? How about I teach you a good move?\nThe move I have in mind is COUNTER.\nNot like the one I'm leaning on, mind you!","Text_CounterWhichMon":"Which POKéMON should I teach COUNTER to?","Text_CounterTaught":"Are you using that COUNTER move I taught your POKéMON?","Text_CounterDeclined":"You're not interested? Come see me if you change your mind.","Text_MetronomeTeach":"Tch-tch-tch! I'll teach you a nifty move.\nTeach it to a POKéMON, and watch the fun unfold!\nIt's a move called METRONOME. Does it strike your fancy?","Text_MetronomeWhichMon":"Okay! Which POKéMON should I teach?","Text_MetronomeTaught":"Tch-tch-tch! That's the sound of a METRONOME.\nIt tweaks your POKéMON's brain into using moves it doesn't even know.","Text_MetronomeDeclined":"I tell you, it's a lot of fun!","gText_PlayerHandedOverTheItem":"{PLAYER} handed over the {STR_VAR_1}.","PokemonMansion_Text_PressSecretSwitch":"A secret switch!\nPress it?","PokemonMansion_Text_WhoWouldnt":"Who wouldn't?","PokemonMansion_Text_NotQuiteYet":"Not quite yet!","Aide_Text_GetEnoughMonsComeBackForItem":"…Oh. I see.\nWhen you get {STR_VAR_1} kinds of POKéMON, come back for the {STR_VAR_2}.","Aide_Text_HaventCaughtEnoughMonsForItem":"Let's see… Uh-oh! You have caught only {STR_VAR_3} kinds of POKéMON!\nYou need {STR_VAR_1} kinds if you want the {STR_VAR_2}.","Aide_Text_DontHaveAnyRoomForItem":"Oh! I see you don't have any room for the {STR_VAR_2}.","Text_PlayedPokeFlute":"{PLAYER} played the POKé FLUTE.","Text_SnorlaxWokeUp":"SNORLAX woke up!\nIt attacked in a grumpy rage!","Text_MimicTeach":"Oh wow! A POKé DOLL!\nFor me? Thank you!\nYou know what? I can teach the move MIMIC.","Text_MimicWhichMon":"I really love MIMIC! Who's going to learn it?","Text_MimicTaughtMale":"{PLAYER}: Hi! Thanks for earlier!\n{PLAYER}: Pardon?\n{PLAYER}: Is it that fun to mimic my every move?\nCOPYCAT: You bet! It's a scream!","Text_MimicTaughtFemale":"{PLAYER}: Hi! Thanks for what you did for us.\n{PLAYER}: Pardon?\n{PLAYER}: Is it really that fun to copy what I say and do?\nCOPYCAT: You bet! It's a scream!","Text_MimicDeclined":"Don't you like MIMIC?","Text_ThunderWaveTeach":"Eeek! No! Stop! Help!\nOh, you're not with TEAM ROCKET. I'm sorry, I thought…\nWill you forgive me if I teach you the THUNDER WAVE technique?","Text_ThunderWaveWhichMon":"Which POKéMON should I teach THUNDER WAVE?","Text_ThunderWaveTaught":"THUNDER WAVE causes paralysis in the target POKéMON.\nA paralyzed POKéMON may be unable to move in battle.\nIt's an ELECTRIC-type move, so it won't work on some POKéMON.","Text_ThunderWaveDeclined":"Oh… But THUNDER WAVE is convenient…","Text_DreamEaterTeach":"Yawn! I must have dozed off in the sun.\nI had this weird dream about a DROWZEE eating my dream.\nAnd… I learned how to eat dreams…\nOogh, this is too spooky!\nLet me teach it to a POKéMON so I can forget about it!","Text_DreamEaterWhichMon":"Which POKéMON wants to learn DREAM EATER?","Text_DreamEaterTaught":"…ZZZ… I…can't eat…anymore…","Text_DreamEaterDeclined":"…Snore…"}}
